# MongoDB Atlas Connection URI
# Replace <db_password> with your actual MongoDB Atlas database user password.
# Example: mongodb+srv://akhiln6_db_user:MySecurePass123@cluster0.2op9u0f.mongodb.net/billing_app?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://akhiln6_db_user:<db_password>@cluster0.2op9u0f.mongodb.net/billing_app?retryWrites=true&w=majority

# Next.js Application URL (Optional for production / Vercel)
NEXT_PUBLIC_APP_URL=http://localhost:3000

